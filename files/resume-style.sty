    {\Huge \bfseries Ujjwal Basumatary} \\ \vspace{2pt}
    \small
    \href{mailto:ujjwalb.physics@gmail.com}{\raisebox{-0.2\height}\faEnvelope\ ujjwalb.physics@gmail.com} ~
    \href{https://ujjwalbasumatary.github.io}{\raisebox{-0.2\height}\faGlobe\ ujjwalbasumatary.github.io} ~
    \href{https://github.com/ujjwalbasumatary}{\raisebox{-0.2\height}\faGithub\ ujjwalbasumatary}
    \vspace{-8pt}
  \end{center}
}

\newenvironment{resumeCoursework}{%
  \par\small\noindent
  \begin{tabular*}{\textwidth}{@{}p{0.34\textwidth}@{\extracolsep{\fill}}r p{0.34\textwidth}r@{}}%
}{%
  \end{tabular*}\par
}

\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{cv-style}[2026/11/06 Academic CV presentation]
\RequirePackage{resume-style}
\RequirePackage{microtype}
\RequirePackage{fancyhdr}

% Restrained burgundy accents, charcoal text, and warm neutral rules.
\definecolor{CVAccent}{HTML}{6B2938}
\definecolor{CVInk}{HTML}{252222}
\definecolor{ResumeSecondary}{HTML}{625B58}
\colorlet{AcademicBlue}{CVAccent}
\colorlet{ResumeHeading}{CVAccent}
\definecolor{ResumeRule}{HTML}{D3CBC5}
\AtBeginDocument{\color{CVInk}}

\titleformat{\section}{%
  \raggedright\fontsize{13}{16}\selectfont\scshape\color{ResumeHeading}%
}{}{0em}{}[{\vspace{-2pt}\color{ResumeRule}\titlerule[0.4pt]}]
\titlespacing*{\section}{0pt}{11pt}{7pt}

% Use the original centered name and icon-based contact header from resume-style.

% Dates and locations support the entry title without competing with it.
\renewcommand{\resumeSubheading}[4]{%
  \Needspace{4\baselineskip}%
  \item
    \begin{tabular*}{\linewidth}[t]{l@{\extracolsep{\fill}}r}
      \textbf{#1} & {\small\color{ResumeSecondary} #2} \\
      \textit{\small #3} & \textit{\small\color{ResumeSecondary} #4} \\
    \end{tabular*}\par\vspace{-1mm}%
}

\pagestyle{fancy}
\fancyhf{}
\renewcommand{\headrulewidth}{0pt}
\renewcommand{\footrulewidth}{0pt}
\fancyfoot[L]{\scriptsize\color{ResumeSecondary} Ujjwal Basumatary}
\fancyfoot[R]{\scriptsize\color{ResumeSecondary}\thepage}
\setlength{\footskip}{20pt}

% One blue family ties the header, headings, rules, and links together.
\definecolor{CVAccent}{HTML}{285E78}
\definecolor{CVInk}{HTML}{203B49}
\definecolor{ResumeSecondary}{HTML}{56616A}
\colorlet{AcademicBlue}{CVAccent}
\colorlet{ResumeHeading}{CVAccent}
\colorlet{ResumeRule}{CVAccent!28}

\titleformat{\section}{%
  \raggedright\fontsize{13}{16}\selectfont\scshape\color{ResumeHeading}%
}{}{0em}{}[{\vspace{-2pt}\color{ResumeRule}\titlerule[0.4pt]}]
\titlespacing*{\section}{0pt}{11pt}{7pt}

\renewcommand{\titlesection}{%
  \begingroup
    \raggedright
    {\fontsize{29}{33}\selectfont\bfseries\color{CVInk} Ujjwal Basumatary\par}
    \vspace{5pt}
    {\fontsize{10}{12}\selectfont
      \href{mailto:ujjwalb.physics@gmail.com}{\raisebox{-0.2\height}\faEnvelope\ ujjwalb.physics@gmail.com}\quad
      \href{https://ujjwalbasumatary.github.io}{\raisebox{-0.2\height}\faGlobe\ ujjwalbasumatary.github.io}\quad
      \href{https://github.com/ujjwalbasumatary}{\raisebox{-0.2\height}\faGithub\ ujjwalbasumatary}\par}
  \endgroup
  \vspace{3pt}
}

% Dates and locations support the entry title without competing with it.
\renewcommand{\resumeSubheading}[4]{%
  \Needspace{4\baselineskip}%
  \item
    \begin{tabular*}{\linewidth}[t]{l@{\extracolsep{\fill}}r}
      \textbf{#1} & {\small\color{ResumeSecondary} #2} \\
      \textit{\small #3} & {\small\color{ResumeSecondary} #4} \\
    \end{tabular*}\par\vspace{-1mm}%
}

\pagestyle{fancy}
\fancyhf{}
\renewcommand{\headrulewidth}{0pt}
\renewcommand{\footrulewidth}{0pt}
\fancyfoot[L]{\scriptsize\color{ResumeSecondary} Ujjwal Basumatary}

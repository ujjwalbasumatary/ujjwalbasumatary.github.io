\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{resume-theme}[2026/11/08 One-page resume presentation]
\RequirePackage{resume-style}
\RequirePackage{microtype}

% Strong navy hierarchy with near-black text and clear blue-gray dividers.
\definecolor{ResumeHeading}{HTML}{193D63}
\definecolor{AcademicBlue}{HTML}{245D96}
\definecolor{ResumeSecondary}{HTML}{343C46}
\definecolor{ResumeRule}{HTML}{879BB0}
\definecolor{ResumeInk}{HTML}{17191D}
\AtBeginDocument{\color{ResumeInk}}

\titleformat{\section}{%
  \raggedright\fontsize{13}{16}\selectfont\bfseries\color{ResumeHeading}%
}{}{0em}{}[{\vspace{-2pt}\color{ResumeRule}\titlerule[0.6pt]}]
\titlespacing*{\section}{0pt}{9pt}{5pt}

% Dates remain upright; affiliations and locations are italic.
\renewcommand{\resumeSubheading}[4]{%
  \Needspace{4\baselineskip}%
  \item
    \begin{tabular*}{\linewidth}[t]{l@{\extracolsep{\fill}}r}
      \textbf{#1} & {\small\color{ResumeSecondary} #2} \\
      \textit{\small #3} & \textit{\small\color{ResumeSecondary} #4} \\
    \end{tabular*}\par\vspace{-1mm}%
}
